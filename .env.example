# Use the local Compose service or a Neon PostgreSQL connection URL.
DATABASE_URL=
# Render only: direct Neon URL for Prisma migrations. Omit locally.
# DATABASE_URL_UNPOOLED=
# Generate a unique secret per environment with openssl rand -base64 48.
JWT_SECRET=replace-with-generated-secret
NODE_ENV=development

# Set these for the local Compose service.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
