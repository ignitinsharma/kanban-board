# Use the local Compose service or a Neon PostgreSQL connection URL.
DATABASE_URL=
# Render only: direct Neon URL for Prisma migrations. Omit locally.
# DATABASE_URL_UNPOOLED=
# Generate a secret with at least 32 bytes for each environment.
JWT_SECRET=
NODE_ENV=development

# Set these for the local Compose service.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
